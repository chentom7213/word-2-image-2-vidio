# Copy to .env on the test server and replace SERVER_IP with its reachable IP
# (or use the final HTTPS domain once TLS is configured).
WEB_PORT=8080
PUBLIC_BASE_URL=http://SERVER_IP:8080
CORS_ORIGIN=http://SERVER_IP:8080

# Single-machine acceptance mode keeps the built-in renderer and mock payment.
NODE_ENV=development
PAYMENT_PROVIDER=mock
REFRESH_COOKIE_SECURE=false
WORKER_CONCURRENCY=1
FFMPEG_THREADS=2

# Replace before exposing the machine outside a trusted test network.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-value
DB_PASSWORD=replace-with-a-long-random-value
JWT_SECRET=replace-with-at-least-32-random-characters
STORAGE_SIGN_SECRET=replace-with-at-least-32-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Optional Stripe Checkout. Leave commented so the default gateway stays mock.
# Registered only when PAYMENT_PROVIDER=stripe and both secrets are non-empty.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE=https://api.stripe.com
# Optional Alipay (RSA2). Leave commented so PAYMENT_PROVIDER stays mock.
# Registered only when PAYMENT_PROVIDER=alipay and ALIPAY_APP_ID,
# ALIPAY_PRIVATE_KEY, and ALIPAY_PUBLIC_KEY are all non-empty.
# A missing secret does not fall back to mock. ALIPAY_API_BASE can point at
# a local mock instead of the live Alipay gateway.
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_API_BASE=https://openapi.alipay.com
# Optional WeChat Pay API v3. Leave commented so PAYMENT_PROVIDER stays mock.
# Registered only when PAYMENT_PROVIDER=wechat and WECHAT_APP_ID, WECHAT_MCH_ID,
# WECHAT_PRIVATE_KEY, WECHAT_SERIAL_NO, WECHAT_PLATFORM_PUBLIC_KEY, and a
# 32-character WECHAT_API_V3_KEY are all set. A missing secret does not fall
# back to mock. Notification resources are decrypted with that APIv3 key.
# WECHAT_API_BASE can point at a local mock instead of the live WeChat Pay API.
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_PRIVATE_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PLATFORM_PUBLIC_KEY=
# WECHAT_API_V3_KEY=
# WECHAT_API_BASE=https://api.mch.weixin.qq.com
METRICS_TOKEN=replace-with-at-least-32-random-characters

# Cache organization membership roles in Redis; 0 disables the cache.
RBAC_MEMBERSHIP_CACHE_TTL_SECONDS=300

# Bound Docker stdout/stderr usage per container (20 MB x 5 files by default).
CONTAINER_LOG_MAX_SIZE=20m
CONTAINER_LOG_MAX_FILES=5

# Allow the embedded worker to finish or checkpoint an active ffmpeg task on shutdown.
API_STOP_GRACE_PERIOD=5m

# Default limits target a 4 vCPU / 8 GiB test machine; lower them together for smaller hosts.
MYSQL_CPU_LIMIT=1.5
MYSQL_MEMORY_LIMIT=1536m
MYSQL_PIDS_LIMIT=256
MYSQL_SHM_SIZE=256m
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=512m
REDIS_PIDS_LIMIT=128
REDIS_MAXMEMORY=384mb
STORAGE_INIT_CPU_LIMIT=0.25
STORAGE_INIT_MEMORY_LIMIT=256m
STORAGE_INIT_PIDS_LIMIT=64
MIGRATE_CPU_LIMIT=0.5
MIGRATE_MEMORY_LIMIT=512m
MIGRATE_PIDS_LIMIT=128
API_CPU_LIMIT=2.5
API_MEMORY_LIMIT=3g
API_PIDS_LIMIT=512
WEB_CPU_LIMIT=0.25
WEB_MEMORY_LIMIT=128m
WEB_PIDS_LIMIT=128

# Tracing stays off for the default single-machine test. The API exports spans
# only when both variables are set. OTEL_EXPORTER_OTLP_TRACES_ENDPOINT is passed
# through as the `url` of @opentelemetry/exporter-trace-otlp-proto, so it must
# include /v1/traces (for example http://otel-collector:4318/v1/traces).
# Leave both unset here. docker-compose.observability.yml is an opt-in overlay:
# it sets OTEL_ENABLED=true and that Collector URL on the api service.
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Used only with docker-compose.observability.yml.
OTEL_COLLECTOR_CPU_LIMIT=0.5
OTEL_COLLECTOR_MEMORY_LIMIT=512m
OTEL_COLLECTOR_PIDS_LIMIT=128
OTEL_COLLECTOR_HTTP_PORT=4318
TEMPO_INIT_CPU_LIMIT=0.25
TEMPO_INIT_MEMORY_LIMIT=128m
TEMPO_INIT_PIDS_LIMIT=64
TEMPO_CPU_LIMIT=0.5
TEMPO_MEMORY_LIMIT=768m
TEMPO_PIDS_LIMIT=256
TEMPO_QUERY_PORT=3200

SEED_EMAIL=demo@benchu.art
SEED_PASSWORD=replace-demo-password

# Optional generic HTTP model provider. Keep commented so single-node smoke
# stays on the built-in renderer (no vendor key, nothing registered).
# PROVIDER_HTTP_ID=http
# PROVIDER_HTTP_BASE_URL=
# PROVIDER_HTTP_API_KEY=
# PROVIDER_HTTP_POLL_MS=200
# PROVIDER_HTTP_TIMEOUT_MS=120000

# Optional C2PA content credentials. Leave both unset for the default
# single-machine flow: output files are not signed, and an unsigned file is
# not treated as having a content credential. Signing runs only when
# C2PA_CERT_PEM and C2PA_KEY_PEM are both non-empty and the plan requires a
# watermark. Paid plans are never signed. The certificate must be issued by a
# CA; a self-signed certificate is rejected and fails the task. Do not put a
# real certificate or private key in this file.
# C2PA_CERT_PEM=
# C2PA_KEY_PEM=
