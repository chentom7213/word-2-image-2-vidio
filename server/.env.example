# --- server ---
PORT=4000
HOST=127.0.0.1

# --- database (local isolated MySQL dev instance on 3307) ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=benchu
DB_PASSWORD=benchu_dev_pw
DB_NAME=benchu_canvas

# --- redis / task queue ---
# QUEUE_ENABLED=false falls back to DB polling (single-node dev without Redis).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
QUEUE_ENABLED=true
QUEUE_STREAM=gen:tasks
QUEUE_GROUP=workers
WORKER_CONCURRENCY=1
# Membership roles are write-through cached; MySQL stays authoritative.
RBAC_MEMBERSHIP_CACHE_TTL_SECONDS=300
# Set to false and run `npm run worker` to scale rendering separately.
EMBEDDED_WORKER=true
WORKER_NAME=api

# --- auth ---
JWT_SECRET=change-me-in-production-please
# Access tokens are short-lived; the refresh cookie drives steady-state sessions.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_DAYS=7
# Must be true behind TLS. In production this is a hard requirement.
REFRESH_COOKIE_SECURE=false
# Optional: set to your API domain in production (e.g. api.example.com).
REFRESH_COOKIE_DOMAIN=

# --- storage (object store) ---
# local = filesystem under OUTPUT_DIR, served by /media/* with HMAC-signed URLs.
#         Correct choice for a single server: no network hop, no per-request
#         cost, no credentials to rotate.
# s3    = any S3-compatible store (AWS S3 / MinIO / R2 / B2).
# Switching is a config change only; object keys and the client contract are
# identical either way.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
OUTPUT_DIR=./storage
STORAGE_SIGN_SECRET=change-me-too-in-production
STORAGE_SIGN_TTL=3600

# Only read when STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=benchu
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO and most self-hosted gateways require path-style addressing.
S3_FORCE_PATH_STYLE=true
# Optional CDN origin in front of the bucket; when set, signedUrl() returns a
# CDN URL and the bucket itself must stay private.
S3_PUBLIC_BASE_URL=

# --- render ---
FFMPEG_PATH=ffmpeg
FFMPEG_THREADS=2
RENDER_MAX_PIXELS=409600
RENDER_FPS=12
RENDER_TIMEOUT_MS=120000

# --- background jobs ---
STALE_TASK_MINUTES=10
REAPER_INTERVAL_MS=60000

# --- moderation ---
MODERATION_ENABLED=true
# Comma-separated extra blocked phrases appended to the built-in blocklist.
MODERATION_BLOCKLIST=
# 输出内容审核：内部图像分类服务地址。留空则只信任本地渲染器；
# 一旦接入远程模型（provider.remote=true），未配置此项会 fail-closed。
# 服务约定：POST JSON { image: <base64>, mime } → { flagged: bool, reason?: string }
MODERATION_OUTPUT_URL=
MODERATION_OUTPUT_TOKEN=
MODERATION_OUTPUT_TIMEOUT_MS=8000

# --- cors ---
CORS_ORIGIN=http://127.0.0.1:5184,http://localhost:5184,http://127.0.0.1:5183,http://localhost:5183,http://127.0.0.1:5173,http://localhost:5173

# --- observability ---
# LOG_JSON=true emits one JSON object per line (Loki / Datadog / ELK friendly).
LOG_JSON=false
LOG_LEVEL=info
# Protect /api/metrics behind a token when it must be public. Scrapers send
# `Authorization: Bearer <token>`; leave empty to allow unauthenticated scrapes
# from inside the cluster only (nginx already 403s it from the internet).
METRICS_TOKEN=

# OpenTelemetry traces are opt-in. Set both values when an OTLP Collector,
# Tempo, Jaeger, or vendor gateway is reachable. The endpoint must include
# `/v1/traces`, for example http://otel-collector:4318/v1/traces.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=benchu-canvas-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# --- billing / payments ---
# mock lets you exercise the whole purchase flow locally with no merchant
# account. It is REFUSED when NODE_ENV=production (it grants credits for free).
PAYMENT_PROVIDER=mock
# HMAC secret for webhook signature verification. Required even for mock.
PAYMENT_WEBHOOK_SECRET=change-me-in-production
# Abandoned orders expire after this many minutes.
PAYMENT_ORDER_TTL_MINUTES=30
# Used to build gateway return/callback URLs.
PUBLIC_BASE_URL=http://127.0.0.1:4000

# Optional Stripe Checkout. Leave commented so PAYMENT_PROVIDER stays mock.
# Registered only when PAYMENT_PROVIDER=stripe and both secrets are non-empty.
# STRIPE_API_BASE can point at a local mock instead of the live Stripe API.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE=https://api.stripe.com

# Optional Alipay (RSA2). Leave commented so PAYMENT_PROVIDER stays mock.
# Registered only when PAYMENT_PROVIDER=alipay and ALIPAY_APP_ID,
# ALIPAY_PRIVATE_KEY, and ALIPAY_PUBLIC_KEY are all non-empty.
# A missing secret does not fall back to mock. ALIPAY_API_BASE can point at
# a local mock instead of the live Alipay gateway.
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_API_BASE=https://openapi.alipay.com

# Optional WeChat Pay API v3. Leave commented so PAYMENT_PROVIDER stays mock.
# Registered only when PAYMENT_PROVIDER=wechat and WECHAT_APP_ID, WECHAT_MCH_ID,
# WECHAT_PRIVATE_KEY, WECHAT_SERIAL_NO, and WECHAT_PLATFORM_PUBLIC_KEY are all
# non-empty. A missing secret does not fall back to mock. WECHAT_API_BASE can
# point at a local mock instead of the live WeChat Pay API.
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_PRIVATE_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PLATFORM_PUBLIC_KEY=
# WECHAT_API_BASE=https://api.mch.weixin.qq.com

# --- enterprise OIDC SSO (Azure AD / Okta / Keycloak / Auth0) ---
# Disabled until all four identity-provider values are supplied. The callback
# must be registered verbatim at the IdP; use HTTPS in production.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:4000/api/auth/oidc/callback
# Frontend page to enter after a successful callback (must be an approved app URL).
OIDC_SUCCESS_REDIRECT=http://127.0.0.1:5183/video
OIDC_SCOPES=openid profile email
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Keep false unless an administrator has approved linking existing passwords to the IdP.
OIDC_AUTO_LINK_EXISTING=false

# --- seed default account ---
SEED_EMAIL=demo@benchu.art
SEED_PASSWORD=demo1234

# --- optional generic HTTP model provider ---
# Leave these commented. An empty PROVIDER_HTTP_BASE_URL does not register
# an adapter, so single-node smoke keeps using the built-in renderer.
# PROVIDER_HTTP_ID=http
# PROVIDER_HTTP_BASE_URL=
# PROVIDER_HTTP_API_KEY=
# PROVIDER_HTTP_POLL_MS=200
# PROVIDER_HTTP_TIMEOUT_MS=120000
