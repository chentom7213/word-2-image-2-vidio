{
  "name": "benchu-canvas-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/bootstrap-api.js",
  "scripts": {
    "dev": "tsx watch src/bootstrap-api.ts",
    "worker": "tsx src/bootstrap-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap-api.js",
    "start:worker": "node dist/bootstrap-worker.js",
    "db:init": "tsx src/db/init.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "db:setup": "npm run db:migrate && npm run db:init",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "render:smoke": "tsx scripts/render-smoke.ts",
    "e2e": "tsx scripts/e2e.ts",
    "drill:reaper": "tsx scripts/reaper-drill.ts",
    "drill:billing": "tsx scripts/billing-e2e.ts",
    "drill:s3": "tsx scripts/s3-drill.ts",
    "drill:migrations": "tsx scripts/migration-drill.ts",
    "grant:monthly-credits": "tsx src/scripts/grant-monthly-credits.ts",
    "storage:lifecycle": "tsx src/scripts/storage-lifecycle.ts",
    "storage:plan-retention": "tsx src/scripts/storage-plan-retention.ts",
    "storage:tiers": "tsx src/scripts/storage-tiers.ts",
    "storage:upload-expiry": "tsx src/scripts/storage-upload-expiry.ts",
    "audit:archive": "tsx src/scripts/archive-audit-logs.ts",
    "account:purge": "tsx src/scripts/purge-deleted-accounts.ts",
    "account:unsuspend": "tsx src/scripts/unsuspend-account.ts"
  },
  "dependencies": {
    "@contentauth/c2pa-node": "^0.9.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.300.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.2",
    "jose": "^6.2.13",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.9.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
